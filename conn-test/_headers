# 为所有文件添加跨域和缓存设置
/*
  Access-Control-Allow-Origin: *
  # 缓存时间设为 1 天 (86400秒)，极致节省回源流量
  Cache-Control: public, max-age=86400
  Connection: keep-alive
  # 为了兼容某些严格检查 Content-Type 的客户端
  Content-Type: text/plain; charset=utf-8

# 针对特定路径强制覆盖
/generate_204
  Content-Length: 0
  
/success
  Content-Length: 0