# 复制为 server/.env 后修改。切勿把真实密钥提交到仓库。
# 注意：登录方式 / Turnstile / SMTP / OIDC / 站点地址也可以在后台 /admin/settings 配置，
#       这里的值只是“未在后台配置时”的回落默认值。
# ---------------------------------------------------------------
# 基础
PP_ADDR=:8080
PP_MYSQL_DSN=root:proxypilot@tcp(127.0.0.1:3306)/proxypilot?charset=utf8mb4&parseTime=false&loc=UTC
# 必须与 Cloudflare Worker 的 JWT_SECRET 保持一致，切换域名后已签发的 token 才继续有效
# 生成：openssl rand -base64 48
PP_JWT_SECRET=change-me-to-a-long-random-string
PP_SUPER_ADMIN=admin
# 生产必配：首次启动时若 admin 仍是默认口令 password，用它重置（留空则仅打印告警）
PP_ADMIN_PASSWORD=
PP_AUTO_MIGRATE=1
# 对外访问地址（反代后必填，用于 /agent-dist 下载地址、OIDC 回调推导）
# PP_PUBLIC_BASE_URL=https://pp.example.com

# ---------------------------------------------------------------
# 前端 / 登录
# 生产 UI 已内嵌（来自 worker bundle），无需构建；如需自定义构建再设置：
# PP_WEB_DIST=/opt/proxypilot/web-dist
PP_TURNSTILE_SITE_KEY=
PP_TURNSTILE_SECRET=

# 仅 SSO：禁用密码登录
# PP_OIDC_DISABLE_PASSWORD=1
# PP_OIDC_ISSUER=https://id.example.com
# PP_OIDC_CLIENT_ID=
# PP_OIDC_CLIENT_SECRET=
# PP_OIDC_SCOPES=openid profile email
# PP_OIDC_PROVIDER_NAME=
# PP_OIDC_BUTTON_TEXT=
# PP_OIDC_REDIRECT_URI=https://pp.example.com/api/oidc/callback

# 验证码邮件（STARTTLS，587）；留空时发送接口返回 503
# PP_SMTP_ADDR=smtp.example.com:587
# PP_SMTP_USER=notice@example.com
# PP_SMTP_PASS=
PP_MAIL_FROM=notice@example.com
# 发信通道：auto（优先 Cloudflare，其次 SMTP）/ smtp / cloudflare
PP_MAIL_PROVIDER=auto
# Cloudflare API Token：R2 对象存储 + Email Sending 共用（不是 Workers 绑定）
PP_CLOUDFLARE_API_TOKEN=
PP_CLOUDFLARE_ACCOUNT_ID=
PP_CLOUDFLARE_FROM=

# ---------------------------------------------------------------
# 本地存储（替代 R2/S3）
# 容器内默认 /app/data/bucket 与 /app/agent-dist，本机运行默认 server/data/bucket 与 agent/dist
# PP_BUCKET_DIR=/app/data/bucket
# PP_AGENT_DIST_DIR=/app/agent-dist
# 只有需要沿用旧的 S3 分发时才设置（留空 = 本站 /agent-dist）
# PP_AGENT_BINARY_BASE_URL=

# Agent 令牌加密密钥（留空回落 PP_JWT_SECRET；与 Worker AGENT_KEY_SECRET 一致才能解密旧密文）
# PP_AGENT_KEY_SECRET=

# ---------------------------------------------------------------
# 过渡期：未注册路径转发给旧 Worker（切流稳定后可移除）
# PP_LEGACY_BASE=https://proxypilot.example.com

# MySQL root 密码（docker compose 使用）
MYSQL_ROOT_PASSWORD=proxypilot

# R2 附件管理 / Agent 分发（S3 兼容 API；使用上面的统一 Token，不再单独配置 R2 Key）
PP_R2_BUCKET=proxypilot
# 留空则按 PP_CLOUDFLARE_ACCOUNT_ID 生成 https://<account>.r2.cloudflarestorage.com
PP_R2_ENDPOINT=
# R2 公共自定义域，用于生成 CDN 外链（留空则只用鉴权下载）
PP_CDN_BASE_URL=
# 兼容旧部署的可选回退（统一 Token 优先）：
# PP_R2_ACCESS_KEY_ID=
# PP_R2_SECRET_ACCESS_KEY=
