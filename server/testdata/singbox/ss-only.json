{
  "template": {
    "name": "golden",
    "port_base": 13700,
    "warp_base": 13800,
    "cert_path": "/etc/sing-box/cert.crt",
    "key_path": "/etc/sing-box/private.key",
    "ss_method": "2022-blake3-aes-256-gcm",
    "ss_server_key": "SERVERKEY",
    "reality_private_key": "PRIVATEKEY",
    "reality_public_key": "PUB",
    "reality_short_id": "abcd",
    "reality_dest": "www.microsoft.com:443",
    "reality_sni": "www.microsoft.com",
    "ws_sni": "www.bing.com",
    "protocol_options": "{}",
    "enable_ss": 1,
    "enable_anytls": 0,
    "enable_hy2": 0,
    "enable_vmess": 0,
    "enable_reality": 0,
    "enable_vlws": 0,
    "enable_masque": 0
  },
  "users": [
    {
      "name": "u1",
      "uuid": "11111111-2222-3333-4444-555555555555",
      "ss_password": "SSPASS1"
    },
    {
      "name": "u2",
      "uuid": "66666666-7777-8888-9999-000000000000",
      "ss_password": "SSPASS2"
    }
  ],
  "ports": {
    "hy2": 13701,
    "hy2_warp": 13801,
    "ss": 13702,
    "ss_warp": 13802,
    "anytls": 13703,
    "anytls_warp": 13803,
    "vmess": 13704,
    "vmess_warp": 13804,
    "reality": 13705,
    "reality_warp": 13805,
    "vlws": 13706,
    "vlws_warp": 13806,
    "masque": 13707,
    "masque_warp": 13807,
    "base": 13700,
    "warp_base": 13800
  },
  "sb": {
    "log": {
      "disabled": false,
      "level": "warning",
      "timestamp": true
    },
    "inbounds": [
      {
        "type": "shadowsocks",
        "tag": "ss2022-sb",
        "listen": "::",
        "listen_port": 13702,
        "method": "2022-blake3-aes-256-gcm",
        "password": "SERVERKEY",
        "users": [
          {
            "name": "u1",
            "password": "SSPASS1"
          },
          {
            "name": "u2",
            "password": "SSPASS2"
          }
        ]
      }
    ],
    "outbounds": [
      {
        "type": "direct",
        "tag": "direct"
      }
    ],
    "route": {
      "final": "direct",
      "default_domain_resolver": {
        "server": "dns-remote",
        "strategy": "prefer_ipv4"
      },
      "rules": [
        {
          "action": "sniff"
        },
        {
          "action": "resolve",
          "strategy": "prefer_ipv4"
        },
        {
          "ip_cidr": [
            "::/0",
            "0.0.0.0/0"
          ],
          "outbound": "direct"
        }
      ]
    },
    "dns": {
      "servers": [
        {
          "tag": "dns-remote",
          "type": "udp",
          "server": "1.1.1.1"
        },
        {
          "tag": "dns-remote2",
          "type": "udp",
          "server": "8.8.8.8"
        },
        {
          "tag": "localv4",
          "type": "local"
        }
      ]
    }
  }
}
