    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "antd": "^6.6.8",
    "antd-mobile": "^5.43.0",
    "dayjs": "1.11.13",
    "react": "18.3.1",
    "react-dom": "18.3.1"
