{
  "name": "proxypilot-web-antd",
  "private": true,
  "version": "15.4.0",
  "type": "module",
  "description": "ProxyPilot 管理后台 · Ant Design 6 + React 18（构建后内嵌进 Go 服务）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "preview": "node scripts/preview.mjs",
